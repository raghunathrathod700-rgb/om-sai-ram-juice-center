# Copy this file to ".env" and fill the values. Restart `npm run dev` after editing.

# --- Backend (Spring Boot + MySQL) ------------------------------------------
# Address of the backend (see /backend). When set, the website uses REAL data:
# menu & prices from MySQL, customer accounts, orders, online payments and the /admin panel.
# Leave EMPTY to run the local demo (everything stays inside the browser).
# Example: http://localhost:8080
VITE_API_BASE_URL=

# --- Local demo only (no backend) -------------------------------------------
# Public Razorpay key for the client-only test popup. With the backend, the Razorpay keys
# are set on the SERVER (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET) and this is not needed.
VITE_RAZORPAY_KEY_ID=
